# ───────────────────────────────────────────────────────────────────────────────
# Aimash — операционные ДЕФОЛТЫ (несекретные). ОТСЛЕЖИВАЕТСЯ git и деплоится в прод.
#
# Как это работает: docker-compose подключает env_file в порядке [.env.defaults, .env].
# Здесь — общие операционные значения (интервалы, лимиты, расписание, логи). В серверном
# .env (untracked, НЕ в git) — ТОЛЬКО секреты (токены/ключи/DB/whitelist/encryption) и любые
# ПЕРЕОПРЕДЕЛЕНИЯ этих дефолтов: .env идёт последним → побеждает.
#
# ⛔ СЕКРЕТОВ ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО. Всё, что секрет — только в серверном .env.
# ───────────────────────────────────────────────────────────────────────────────

# --- Логи ---
LOG_LEVEL=INFO                                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                                # прод: структурные логи для агрегатора/grep

# --- Модель (тюнинг, несекретно; сами модели LLM_PARSING/COPY/FALLBACK — в серверном .env) ---
OPENROUTER_PARSING_PROVIDER_SORT=              # пусто | throughput | latency
MODEL_CHOICES=                                 # пусто = дефолтный набор в agent.router
LLM_MAX_TOKENS_PARSING=1024                    # разбор команд → крошечный tool-call
LLM_MAX_TOKENS_COPY=2048                       # копирайт RSA → короткий JSON
OPENROUTER_PRICE_FLOOR=false                   # false = надёжность важнее экономии копеек

# --- Google Ads (несекретные операционные) ---
GOOGLE_ADS_LOGIN_CUSTOMER_IDS=                 # доп. MCC для обхода (CSV); пусто = только основной
GOOGLE_ADS_DAILY_OP_LIMIT=15000                # дневной лимит операций API; на 95% мутации блокируются (/quota)

# --- Наблюдаемость (по умолчанию ВЫКЛ; DSN — секрет, кладётся в серверный .env, НЕ сюда) ---
SENTRY_TRACES_SAMPLE_RATE=0.0                  # 0.0 = перф-трейсинг выкл (без оверхеда)

# --- Планировщик (§14, всё read-only) ---
# ⏰ ВРЕМЯ — по таймзоне контейнера. Контейнер на UTC (python-base, TZ не задан).
# 0 1 * * *  = 01:00 UTC = 10:00 JST (10 утра по Японии) — плановый отчёт.
# Если сервер НЕ на UTC — сдвинуть cron (проверка: docker compose exec bot date -u).
REPORT_SCHEDULE=0 1 * * *
ANOMALY_INTERVAL_HOURS=6                        # проверка аномалий + алерты каждые N часов
CLEANUP_INTERVAL_MINUTES=60                     # очистка просроченного каждые N минут
CAMPAIGN_DRAFT_TTL_HOURS=72                     # (§19) TTL черновика визарда; старше → abandoned

# --- §20 «Информация про клиентов»: краулинг сайта (статический, без headless) ---
CRAWL_MAX_PAGES=70                              # потолок страниц за обход (ТЗ §20.4 «50–100»)
CRAWL_MAX_DEPTH=3                               # глубина BFS от главной
CRAWL_TIME_BUDGET_S=90                          # общий бюджет времени на обход
CRAWL_DELAY_S=0.5                               # вежливая пауза между запросами к домену
CRAWL_MAX_TEXT_CHARS=5000                       # сколько текста берём с одной страницы
CRAWL_STALE_MINUTES=30                          # зависшая running-задача старше N мин → failed
CLIENT_TEXT_IDLE_S=60                           # (§20.3) авто-сохранение накопленного текста по таймауту
