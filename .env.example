# ───────────────────────────────────────────────────────────────
# Aimash — пример окружения. Скопируй в .env и заполни.
# .env в .gitignore — НИКОГДА не коммить реальные значения.
#
# ПРОД (docker-compose): операционные дефолты (интервалы, лимиты краула, LOG_FORMAT,
# расписание) живут в ОТСЛЕЖИВАЕМОМ .env.defaults и деплоятся автоматически. Серверный
# .env держит ТОЛЬКО секреты + переопределения (env_file: [.env.defaults, .env] → .env главнее).
# Этот .env.example — полный шаблон для локальной/чистой установки.
# ───────────────────────────────────────────────────────────────

# --- Модель (через OpenRouter, OpenAI-совместимый API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Сменяемые модели (выбор по A/B-тесту scripts/ab_test_models.py):
# Hermes на OpenRouter НЕ поддерживает function calling → не годится на денежный путь.
# «Что за что»: parsing — разбор КОМАНД (дёшево/быстро, ошибку ловит confirm-гейт); keywords —
# СМЫСЛОВЫЕ keyword-задачи (seed-ключи/релевантность/минус-слова/кластеризация/профиль §20 —
# качество RU-семантики важнее цены); copy — тексты RSA. Ручной /model в боте бьёт эти дефолты.
LLM_PARSING=deepseek/deepseek-chat          # дёшево/быстро, ≈Claude на парсинге команд
LLM_COPY=anthropic/claude-opus-4.8          # максимум качества RSA (реш. владельца 2026-07)
LLM_FALLBACK=anthropic/claude-sonnet-4.6    # запасная при транзиентном сбое основной
# Смысловые keyword-задачи (решение владельца 2026-07): seed/релевантность/минус-слова/
# кластеризация/профиль §20. Пусто = LLM_PARSING (обратная совместимость). Дефолт кода — opus-4.8.
LLM_KEYWORDS=anthropic/claude-opus-4.8      # пусто | vendor/slug (сильная модель ради RU-семантики)
# P2: отдельная модель для КЛАСТЕРИЗАЦИИ/интента keyword research. Пусто = LLM_PARSING
# (прежнее поведение). Задать, чтобы прогнать A/B сильной модели только на интентах.
LLM_CLUSTERING=                             # пусто | vendor/slug (напр. anthropic/claude-sonnet-4.6)
# §20 досье по сайту (map-reduce): extract — ДЕСЯТКИ вызовов на чанк текста (дёшево, механическое
# извлечение фактов в JSON), dossier — ОДИН синтез прозы в конце (качество). Пусто ⇒ extract =
# LLM_PARSING, dossier = LLM_KEYWORDS. Наивный map на opus по 1000 страниц ≈ $21 за сайт — не надо.
LLM_EXTRACT=                                # пусто | vendor/slug (дешёвая parse-модель)
LLM_DOSSIER=                                # пусто | vendor/slug (сильная: связная проза + УТП)
# Ускорение parsing-роли: роутинг к быстрейшему эндпоинту модели (provider:{sort}). Пусто = ВЫКЛ
# (дефолт). throughput = выше токенов/с, latency = ниже TTFT. Только parsing; копирайт не трогает.
# Замерь выигрыш через scripts/ab_test_models.py (колонка TTFT) перед включением в prod.
OPENROUTER_PARSING_PROVIDER_SORT=           # пусто | throughput | latency
# Пресеты моделей для рантайм-переключателя /model (CSV slug'ов OpenRouter). Пусто = дефолтный
# набор в agent.router (tool-use-capable). Своя модель — командой /model в боте.
MODEL_CHOICES=                              # напр. deepseek/deepseek-chat,openai/gpt-4o-mini,anthropic/claude-sonnet-4.6
# Потолок генерации по ролям (явный max_tokens — экономия бюджета OpenRouter без потери качества).
LLM_MAX_TOKENS_PARSING=1024                  # разбор команд → крошечный tool-call
LLM_MAX_TOKENS_COPY=2048                     # копирайт RSA → короткий JSON
LLM_MAX_TOKENS_KEYWORDS=2048                 # фильтр релевантности на 120 ключей → JSON крупнее parsing
LLM_MAX_TOKENS_ANALYST=1536                  # (P3) потолок нарратива /audit (короткий человеч. разбор)
LLM_MAX_TOKENS_EXTRACT=4096                  # (§20) JSON фактов с одного чанка сайта (услуги+люди+факты)
LLM_MAX_TOKENS_DOSSIER=8192                  # (§20) финальный синтез досье: проза + УТП по всему сайту
LLM_MAX_TOKENS_DOSSIER_NORMALIZE=8192       # (§20) reduce-шаг normalize_ru: перевод+дедуп всех списков (крупнее прозы — потолок ≥ dossier)
# P3: модель АНАЛИТИКА (агентный нарратив /audit поверх детерминир. ядра). Пусто = LLM_PARSING.
LLM_ANALYST=                                 # пусто | vendor/slug
# P3: включать ли агентный нарратив в /audit (числа всегда КОД; сбой/timeout → детерминир. карточка).
AUDIT_AGENTIC_NARRATIVE=true                 # true | false
# #6: режим доп-вопросов по /audit — после карточки можно задать вопрос (read-only аналитик, числа КОД).
# Независим от нарратива; false ⇒ карточка без Q&A-подсказки, как раньше.
AUDIT_QA_ENABLED=true                        # true | false
# :floor — роутинг к самому дешёвому провайдеру модели (фиксирует на одном эндпоинте → операционно
# рискованнее). По умолчанию false (надёжность важнее экономии копеек).
OPENROUTER_PRICE_FLOOR=false                 # false | true
# Таймауты денежного пути (сек) — деградация при недоступности OpenRouter / Google Ads.
LLM_TIMEOUT_S=45.0                            # таймаут вызова модели (OpenRouter)
ADS_TIMEOUT_S=60.0                           # таймаут вызова Google Ads SDK на попытку

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                            # @BotFather
# ОБЯЗАТЕЛЬНО (даже в dev): whitelist FAIL-CLOSED — пустой => бот НИКОМУ не ответит.
# В prod пустой whitelist роняет старт (fail-fast). Укажи хотя бы свой chat_id.
TELEGRAM_WHITELIST_CHAT_IDS=                   # через запятую, напр. 12345678,87654321
# Админы бота (/grant /revoke — выдача пер-пользовательских грантов на аккаунты ЧТЕНИЯ).
# Пусто => админ-команды недоступны никому (fail-closed; функция опциональна).
ADMIN_CHAT_IDS=

# Host-level operational alerts. Unlike scheduler alerts, this watcher remains able to notify when
# the bot/scheduler container is down. For a forum supergroup set chat_id and the General topic id;
# omit OPS_ALERT_THREAD_ID to send into the supergroup's default General topic.
OPS_ALERT_CHAT_ID=
OPS_ALERT_THREAD_ID=
# Private trusted-operator profile: all whitelisted users read the full visible MCC ceiling.
# Use auto/enforced only if untrusted or client users are introduced later.
ACCOUNT_ACCESS_MODE=legacy

# --- Google Ads API ---
# Альтернатива google-ads.yaml. developer token — Basic (у Антона).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=                  # ID МЕНЕДЖЕРСКОГО (MCC), напр. 6283738601
# §8/мультиаккаунт: ДОП. MCC (под разными менеджерами) для обхода/логина. CSV. Пусто = только
# основной login_customer_id. Заполни, если read-аккаунты живут под ДРУГИМ MCC (нужен и per-account
# OAuth-токен, если общий refresh их не покрывает).
GOOGLE_ADS_LOGIN_CUSTOMER_IDS=                 # напр. 6283738601,1234567890
# Набор аккаунтов для МУТАЦИЙ (ЗАЩИТА боевых клиентов!): `all` = все ВИДИМЫЕ боту (ЯВНЫЙ сентинел,
# решение владельца), CSV id = сузить, ПУСТО = мутаций нет в ЛЮБОМ окружении (fail-closed; коэрция
# «пусто в prod → all» снята 2026-07-30 — prod поднимается read-only).
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=
# §8: доп. аккаунты ТОЛЬКО для ЧТЕНИЯ (сводка по дочерним MCC + выбор аккаунта в /report /export
# /sheets /account) — мутации на них всё равно запрещены (свой узкий замок ensure_allowed + код-потолок
# ALLOWED_CEILING). Пусто = чтение только на разрешённый аккаунт. Дочерние настроенного MCC и так
# обнаруживаются обходом на старте; этот список — детерминированное дополнение (не зависит от обхода).
# Пример: чтобы дать на ЧТЕНИЕ Aimash 676-404-0266 — добавь 6764040266.
GOOGLE_ADS_READ_CUSTOMER_IDS=6764040266        # через запятую, ТОЛЬКО дочерние настроенного MCC
GOOGLE_ADS_API_VERSION=v25                     # пин; перепроверять ежемесячно
# Дневной лимит операций API (§3): на 95% израсходованного мутации блокируются (команда /quota).
GOOGLE_ADS_DAILY_OP_LIMIT=15000                # операций/сутки на инстанс (single-instance учёт)
# --- BZ-1 аварийный рубильник (стоп ВСЕХ мутаций; чтение работает) ---
# НЕ пусто и не 0/false/no/off ⇒ мутации остановлены. Fail-closed: опечатка = ВКЛЮЧЁН. Читается
# ЖИВЬЁМ из окружения на каждой проверке (мимо кэша настроек) — после правки .env достаточно
# `docker compose up -d` (пересоздать контейнер), рестарта кода не требуется.
DISABLE_ALL_MUTATIONS=
# Local/dev файл-флаг. В Compose переопределён общим read-only mount: на хосте
# `touch /opt/aimash/runtime/safety/KILL_SWITCH` = стоп bot/Hermes MCP + scheduler без рестарта;
# `rm /opt/aimash/runtime/safety/KILL_SWITCH` = обратно. Флаг переживает recreate.
KILL_SWITCH_FILE=KILL_SWITCH
# --- B1-4 суточный blast-radius кап бюджета (окно 24ч, на аккаунт, проверка ДО claim) ---
# Сколько ПОВЫШЕНИЙ бюджета за 24ч (понижения не считаются). 0 = выкл; в prod автодефолт 10.
DAILY_BUDGET_INCREASE_MAX_OPS=0
# Суммарный ПРИРОСТ бюджета за 24ч в единицах валюты аккаунта. 0 = выкл (включается явно).
DAILY_BUDGET_INCREASE_CAP_UNITS=0
# §11 Video: создание VIDEO-кампаний через API — только для allowlist-аккаунтов Google (иначе
# MUTATE_NOT_ALLOWED). Дефолт false ⇒ визард ведёт на Demand Gen (рабочий путь из видео).
GOOGLE_ADS_VIDEO_ENABLED=false                 # true — только если аккаунт в allowlist Google
# ГЕО-дефолт: ISO страны, когда запрос гео НЕ задал (агентство всегда льёт на одну страну). Пусто ⇒
# гео берётся из запроса, при отсутствии — создание требует гео (без хардкод-биаса «UA»).
DEFAULT_GEO_COUNTRY_CODE=                       # напр. UG (Уганда); пусто = резолв из запроса
DEFAULT_GEO_LOCALE=ru                           # язык названий локаций; пусто = вывести из страны

# --- Безопасность ---
ENV=dev                                        # dev | prod  (dev = только test MCC)
# Fernet требует URL-safe Base64, а не прямой hex. Сгенерировать вручную:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=                         # Fernet-ключ для шифрования токенов в БД (32 b64)
# Сгенерировать: openssl rand -hex 32. Не ротировать вместе с Fernet без плана миграции хэшей.
PSEUDONYMIZATION_HMAC_KEY=                      # отдельный стабильный ≥32-byte secret для CRM/SSO ids
# Hermes PLAN/WRITE: включать только после установки trusted gateway plugin. Один и тот же
# случайный ≥32-byte ключ задаётся здесь (MCP) и в ~/.hermes/.env (signer), никогда не в git.
HERMES_WRITE_ENABLED=false
# Сгенерировать: openssl rand -hex 32
AIMASH_TRUST_HMAC_KEY=
# Логи: LOG_LEVEL — уровень; LOG_FORMAT=json рекомендуется в prod (структурные логи для агрегатора).
LOG_LEVEL=INFO                                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                                # text | json (в prod — json)

# --- §12 2FA (опц.): PIN-подтверждение ОПАСНЫХ операций ПЕРЕД исполнением ---
# Opt-in, дефолт OFF, fail-closed (включён без PIN ⇒ опасные операции блокируются). PIN сверяет КОД
# (constant-time). В prod PIN <6 символов роняет старт. После серии неверных — кулдаун + алерт админам.
TWO_FACTOR_ENABLED=false                        # true | false
TWO_FACTOR_PIN=                                 # ≥6 символов в prod; маскируется в логах
TWO_FACTOR_OPS_CSV=remove_campaign,remove_ad_group,update_budget,update_bid,update_keyword_bid,set_bidding_strategy
TWO_FACTOR_LOCKOUT_MINUTES=15                    # базовый кулдаун после серии неверных PIN (растёт экспон.)
FOUR_EYES_REQUIRED=false                         # true: выбранные risk tiers требуют второго approver/admin
FOUR_EYES_RISK_TIERS_CSV=L3                      # дополнение к reply-confirm автора, не его замена

# --- База данных ---
# D3: пароли БД НЕ хранятся в git. POSTGRES_PASSWORD/POSTGRES_RO_PASSWORD читает docker-compose.yml
# (`${VAR:?}` ⇒ без них `docker compose up` ОТКАЗЫВАЕТ стартовать — fail-closed, правило #10) и
# подставляет их и в postgres, и в DATABASE_URL бота, и в бэкап-сайдкар. Придумай СВОИ.
# ⚠️ На уже проинициализированном томе (прод/старый dev) смена пароля НЕ применяется сама:
#    docker compose exec postgres psql -U aimash -c "ALTER ROLE aimash WITH PASSWORD '…';"
#    (и то же для aimash_ro) — иначе бот не подключится после деплоя. См. deploy/hermes/OPERATIONS.md.
POSTGRES_PASSWORD=                              # пароль роли aimash (обязателен для docker compose)
POSTGRES_RO_PASSWORD=                           # пароль read-only роли aimash_ro (Postgres MCP)
# Для запуска БЕЗ docker (alembic/скрипты с хоста): порт 5433, пароль — тот же POSTGRES_PASSWORD.
# В prod дефолтный пароль «aimash» отвергается на старте (core.config) — это утёкший в git пароль.
DATABASE_URL=postgresql+asyncpg://aimash:<POSTGRES_PASSWORD>@localhost:5433/aimash

# --- Google Sheets экспорт (фаза 2) ---
# Scope (drive.file) ЗАШИТ в коде (reports/sheets.py) — отдельной env-настройки нет. Нужен
# ОТДЕЛЬНЫЙ OAuth с этим scope (Ads-токен его не несёт) — команды ниже являются канонической процедурой.
# B3: публичность экспортных таблиц. true (дефолт — прежнее поведение: заказчик открывает ссылку
# без запроса доступа; бот предупреждает «доступно всем»). false ⇒ таблица приватна (финансовые
# данные не за периметром; получатель запрашивает доступ).
SHEETS_PUBLIC_LINK=true                          # true | false

# Лист «Находки» в /export и /sheets: аудит аккаунта (тот же движок, что у /audit) прямо в книге.
# Стоит ≈23 доп. чтения Ads API — только на ЯВНУЮ команду человека (планировщик и веер по MCC
# считают здоровье БЕЗ доп. чтений). false ⇒ книга как раньше, без листа.
EXPORT_FINDINGS=true                             # true | false

# ЧЕЙ Drive хранит созданные ботом таблицы. Пусто ⇒ тот же OAuth, что у Google Ads: файлы падают в
# «Мой диск» аккаунта GOOGLE_ADS_REFRESH_TOKEN и едят его квоту (15 ГБ). Чтобы таблицы жили на ДРУГОМ
# gmail (аккаунт-хранилище), выдай ему отдельный токен:
#     python scripts/get_refresh_token.py --sheets      # войти нужным gmail-ом; scope РОВНО ОДИН: drive.file
# Аккаунт у заказчика (пароль он не отдаёт) ⇒ добавь --remote: скрипт печатает ссылку согласия, заказчик
# открывает её у СЕБЯ и присылает обратно строку из адресной строки.
# Ads-токен при этом не меняется (у аккаунта-хранилища доступа к MCC может и не быть) и остаётся
# ЕДИНСТВЕННЫМ носителем sensitive-scope spreadsheets.readonly: им читаются ЧУЖИЕ таблицы с ключами
# (§19.4.1, /kw add) — значит такая таблица должна быть доступна Ads-аккаунту. У аккаунта-хранилища
# этот scope просить НЕЛЬЗЯ: Google блокирует consent («This app is blocked»), см. docs/OAUTH_SETUP.md.
SHEETS_REFRESH_TOKEN=
SHEETS_CLIENT_ID=                                # пусто ⇒ GOOGLE_ADS_CLIENT_ID (тот же OAuth-клиент)
SHEETS_CLIENT_SECRET=                            # пусто ⇒ GOOGLE_ADS_CLIENT_SECRET
# Ожидаемый владелец таблиц. Не гейт, а СВЕРКА: scripts/check_sheets_share.py читает owners созданного
# файла и падает при расхождении (иначе «не тот Drive» всплывёт, когда кончится чужая квота).
SHEETS_OWNER_EMAIL=                              # напр. myhalads@gmail.com

# --- Наблюдаемость / мониторинг (опционально) ---
# Sentry: алерты о падениях на денежном пути. Пусто = ВЫКЛ (ноль оверхеда и сети, секреты редактятся).
SENTRY_DSN=                                    # https://...@oNNN.ingest.sentry.io/NNN (с dashboard Sentry)
SENTRY_TRACES_SAMPLE_RATE=0.0                  # перф-трейсинг: 0.0 = выкл (без оверхеда); 0.1 = 10% и т.п.
# #10: MANAGEMENT-ключ OpenRouter (дашборд → Provisioning API keys) для GET /api/v1/activity —
# per-день/per-модель разбивка трат за 30 ЗАВЕРШЁННЫХ UTC-дней (историческая сшивка прогонов Hermes в
# agent_runs, origin='hermes'). ОБЫЧНЫЙ inference-ключ на /activity даёт 403 — потому ключ отдельный.
# Пусто ⇒ /activity не зовём вовсе (opt-in, fail-soft: ридер деградирует на /key). СЕКРЕТ, как
# OPENROUTER_API_KEY — реальное значение только в .env, никогда в git (правило 5).
OPENROUTER_PROVISIONING_KEY=
# Фильтр /activity по КОНКРЕТНОМУ ключу: изолировать траты Hermes-ключа от ботовского, если ключи
# разные. Пусто ⇒ без фильтра (весь аккаунт). Сам хэш секретом не является.
OPENROUTER_KEY_HASH=                           # пусто | SHA-256 hex ключа (как отдаёт keys API)

# --- Планировщик / расписание (§14, всё read-only) ---
# C4 (§5.3): ЧЕЙ ПРОЦЕСС владеет джобами. true — исторический режим (APScheduler в петле бота);
# false — джобы у отдельного контейнера `python -m scheduler` (топология «три процесса», так на
# проде: docker-compose.yml). Флаг — НАМЕРЕНИЕ; энфорсмент от двойного запуска — advisory-lock
# роли `scheduler` в БД, поэтому забытый флаг даёт громкий отказ, а не двойные дайджесты.
SCHEDULER_IN_BOT=true                           # дефолт: при архивации bot/ джобы не должны исчезнуть молча
# REPORT_SCHEDULE — стандартная crontab-строка «мин час день месяц день_недели»: одним полем и
# ежедневно, и еженедельно. Невалидную строку scheduler НЕ роняет старт — откат на ежедневно 09:00
# с громким логом (fail-safe). Примеры: "0 9 * * *" (ежедн. 09:00) | "0 9 * * 1" (еженед., пн 09:00).
REPORT_SCHEDULE=0 9 * * *                       # cron по TZ контейнера (прод .env.defaults: 0 1 * * * = 10:00 JST)
ANOMALY_INTERVAL_HOURS=6                        # проверка аномалий + алерты каждые N часов
CLEANUP_INTERVAL_MINUTES=60                     # очистка просроченных черновиков каждые N минут
CAMPAIGN_DRAFT_TTL_HOURS=72                     # (§19) TTL черновика визарда; старше => abandoned
PROPOSAL_TTL_HOURS=24                           # TTL неподтверждённого черновика мутации (часы)
PROPOSAL_TTL_HOURS_L3=2                         # (Волна 5) свой, более КОРОТКИЙ TTL для тира L3; доп. конъюнкт к верхнему — значение больше PROPOSAL_TTL_HOURS срок не удлиняет
REPORT_WINDOW_DAYS=7                            # окно планового отчёта (дни)
ANOMALY_WINDOW_DAYS=7                           # окно сравнения аномалий (дни)
OUTCOME_CHECK_DAYS=7                            # applied budget/keyword: равные окна до/после
OUTCOME_CHECK_SCHEDULE=0 10 * * *               # ежедневный checker по TZ scheduler-контейнера
OUTCOME_CHECK_MAX_ATTEMPTS=3                    # read/LLM/delivery retries до terminal failed
ANOMALY_COOLDOWN_HOURS=24                       # тот же алерт (аккаунт+вид) не чаще раза в N ч; 0=каждый прогон
NOTIFICATION_OUTBOX_INTERVAL_SECONDS=30          # enqueue+delivery worker cadence; 5..3600
NOTIFICATION_OUTBOX_LEASE_SECONDS=120            # lease before crashed delivery is retried; 10..3600
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5               # bounded attempts before dead-letter; 1..20
NOTIFICATION_OUTBOX_BASE_RETRY_SECONDS=30        # exponential retry base; 1..3600
INCIDENT_CRITICAL_ESCALATION_MINUTES=15          # unresolved critical before first escalation; 0=immediate
INCIDENT_WARNING_ESCALATION_MINUTES=240          # unresolved warning before first escalation; 0=immediate
INCIDENT_ESCALATION_COOLDOWN_MINUTES=60          # minimum gap between escalation rounds
MCC_REDISCOVERY_HOURS=24                        # (2.4) суточная re-discovery детей MCC; 0=выкл
# Р6: алерт о правках, сделанных в аккаунте МИМО бота (веб-интерфейс, Editor, чужой API-клиент).
# Google о таких правках не уведомляет — узнать о них можно только опросом `change_event`.
# 0 = выкл (дефолт: на аккаунте с активным агентством это поток, а не сигнал). Прод: 6.
EXTERNAL_CHANGES_INTERVAL_HOURS=0               # (Р6) опрос журнала правок каждые N часов; 0=выкл
EXTERNAL_CHANGES_WINDOW_DAYS=7                  # (Р6) окно опроса, 1..29 (ретенция change_event минус сутки запаса); вне диапазона => 7 с warning
# 1.6: недельный БИЗНЕС-дайджест менеджерам (WoW + топ-3 совета + аномалии), opt-in /bizdigest.
BUSINESS_DIGEST_SCHEDULE=0 9 * * 1              # crontab: пн 09:00
# 2.11: авто-подстройка порогов аномалий (READ-ONLY; предлагает per-account пороги кнопкой). Opt-in.
THRESHOLD_TUNE_ENABLED=false                     # true | false
THRESHOLD_TUNE_SCHEDULE=0 10 * * 2              # crontab: вт 10:00
# §advisor «утренний экран действий»: сколько топ-рекомендаций слать и пауза между сообщениями.
ADVISE_DIGEST_TOP_N=5                            # топ-N советов в проактивном дайджесте
ADVISE_DIGEST_SEND_PAUSE=0.7                     # пауза между сообщениями (flood-limit Telegram)
# §6/§15 (1.3): еженедельный дайджест админам (ошибки+баг-репорты+активность). Opt-in.
WEEKLY_DIGEST_ENABLED=false                      # true | false
WEEKLY_DIGEST_SCHEDULE=0 9 * * 1                # crontab: понедельник 09:00
# N1.1: ретеншн снапшотов health-score /audit (account_health_snapshot); 0=не удалять.
ACCOUNT_HEALTH_RETAIN_DAYS=365

# — §15 наблюдаемость / ретеншн / лимиты (A1/C2/C3) —
# ERROR_ALERT_INTERVAL_MINUTES: (A1) проактивный алерт админам (ADMIN_CHAT_IDS) о НОВЫХ error_events
#   каждые N минут. 0 => выкл. Нет админов => тоже no-op. Дайджест дедуплен, без traceback в чат.
ERROR_ALERT_INTERVAL_MINUTES=0                  # прод: поставь 15 (нужны ADMIN_CHAT_IDS)
ERROR_EVENTS_RETAIN_DAYS=90                     # (C2) purge error_events старше N дней; 0=не чистить (audit_log НЕ трогается)
CRAWL_JOBS_RETAIN_DAYS=30                        # (C2) purge терминальных crawl_jobs старше N дней; 0=не чистить
SITE_PAGE_TEXT_RETAIN_DAYS=90                    # (§20) обнулять ТЕКСТ страниц краула старше N дней (строка с url/title остаётся); 0=хранить вечно
ADS_QUOTA_OPS_RETAIN_DAYS=2                      # (C2) purge строк распределённого счётчика квоты (ads_quota_ops) старше N дней; окно счёта 24ч, дефолт 2 (окно+буфер); 0=не чистить (счёт остаётся верным)
# AGENT_RUNS_RETAIN_DAYS: (Волна 3) ретеншн журнала прогонов (agent_runs + agent_run_events).
#   Убирается ЦЕЛЫМИ прогонами: события сшиты хэш-цепочкой, и вырезанное звено verify_chain обязан
#   считать подделкой — штатная уборка не смеет её имитировать. Прогон с ЛЮБЫМ денежным событием
#   (ads_mutate/compensation) не убирается вовсе: его пол хранения (365 дн.) держит триггер СУБД, а
#   архивация денежного следа — ручная процедура (deploy/hermes/OPERATIONS.md). 0 = не чистить.
AGENT_RUNS_RETAIN_DAYS=90
# — Волна 4: контур автооткатa (наблюдение за применённой мутацией) —
# ROLLBACK_WATCH_MODE: shadow|alert|auto. `shadow` (дефолт) — вердикт пишется в rollback_watch и
#   НИЧЕГО не уходит наружу: копится выборка, по которой оценивается точность детектора. `alert` —
#   человеку приходит текст, обратный черновик рождается в ЕГО ходе обычным путём через confirm-гейт
#   (правок гейта, провенанса и золотых правил — ноль). `auto` (исполнение компенсации кодом) ещё НЕ
#   реализован (Волна 6a) и здесь деградирует до shadow с warning — молчаливое усиление режима
#   исполнения ровно тот класс ошибки, из-за которого настройка «выглядит рабочей».
ROLLBACK_WATCH_MODE=shadow
ROLLBACK_WATCH_WINDOW_HOURS=4                    # окно наблюдения после применения; минимум 2 (за час метрики не набираются)
# ROLLBACK_WATCH_MAD_K: порог = медиана + k×MAD тех же часов тех же дней недели за 4 недели.
#   3.0 — консервативно намеренно: цена ложного «degraded» в режиме auto — чужие деньги, цена
#   пропуска — один невыполненный откат.
ROLLBACK_WATCH_MAD_K=3.0
ROLLBACK_WATCH_RETAIN_DAYS=180                   # purge разобранных наблюдений старше N дней; 0=не чистить (денежный след живёт в audit_log)
# Retention касается только operational history; proposals/audit/votes/roles/identity не удаляются.
OPERATIONS_RETAIN_DAYS=365                        # terminal decisions/incidents/experiments + pacing; 0=не чистить
REVENUE_EVENTS_RETAIN_DAYS=730                    # PII-free CRM events; 0=не чистить
CHANNEL_METRICS_RETAIN_DAYS=730                   # provider-neutral daily snapshots; 0=не чистить
LLM_DAILY_CALLS_PER_USER=0                       # (C3) пер-юзер дневной потолок LLM-вызовов (fail-closed на 100%); 0=без лимита
# #10: дневной потолок СТОИМОСТИ LLM (USD) — рубеж НИЖЕ агента. Считает не вызовы, а РЕАЛЬНУЮ трату
# (OpenRouter /key usage_daily через core.or_activity), поэтому покрывает и автономный Hermes-цикл,
# который идёт мимо нашего процесса и в LLM_DAILY_CALLS_PER_USER не попадает вовсе. Энфорсится в
# agent/router.chat (BZ-4, единая точка наших LLM-вызовов; трата кэшируется 60 с — не GET на вызов) +
# ранний человекочитаемый отказ в NL-входе. Трату прочитать не удалось ⇒ прогон ПРОПУСКАЕТСЯ с warning:
# это БЮДЖЕТНЫЙ рубеж, не security-гейт (мутации всё равно за confirm/провенансом), а жёсткий
# backstop — limit+limit_reset:daily на самом ключе OpenRouter (RB-3).
LLM_DAILY_COST_CAP_USD=0.0                       # USD/сутки; 0=ВЫКЛ в dev, в prod автодефолт 10 (D1). Ставить НИЖЕ серверного лимита ключа

# — §20 «Информация про клиентов»: краулинг сайта клиента (статический, без headless) —
# Жёсткие лимиты, чтобы не перегружать чужой сайт и не голодить event loop (краул — в фоне).
CRAWL_MAX_PAGES=1000                            # потолок страниц за обход (отклонение от ТЗ §20.4 «50–100» — по прямому указанию владельца)
CRAWL_MAX_DEPTH=3                               # глубина обхода от главной
CRAWL_CONCURRENCY=6                             # одновременных запросов к сайту (потолок вежливости — 8, выше не поднять)
CRAWL_TIME_BUDGET_S=240                         # бюджет времени на обход; вышло — отдаём собранное (partial), не выбрасываем
CRAWL_DELAY_S=0.5                               # минимальная пауза между запросами (перебивается Crawl-delay из robots.txt, если он больше)
CRAWL_MAX_TEXT_CHARS=5000                       # сколько текста берём с одной страницы
CRAWL_STORE_MAX_PAGES=1000                      # сколько страниц храним в client_site_pages (единственный потолок хранения)
CRAWL_LLM_TEXT_CHARS=24000                      # (§20.4) общий бюджет текста сайта в промпт LLM
CRAWL_LLM_PER_PAGE_CHARS=1500                   # квота одной страницы в этом бюджете (чтобы /price и /catalog доехали)
CRAWL_STALE_MINUTES=30                          # зависшая running-задача старше N мин => failed

# — §20 ДОСЬЕ: map-reduce поверх СОХРАНЁННОГО текста страниц (client_site_pages.text) —
DOSSIER_CHUNK_CHARS=7000                        # размер чанка map-фазы (текст уже без шаблона nav/footer)
DOSSIER_MAP_CONCURRENCY=4                       # одновременных вызовов LLM на map-фазе
DOSSIER_MAX_MAP_CALLS=40                        # потолок map-вызовов на сайт; жёсткий литерал HARD_MAP_CALLS_CAP=64 в коде — env может только ОПУСТИТЬ
DOSSIER_MAX_PAGES_PER_TYPE=12                   # сколько страниц одного низкоценного типа (catalog/blog) идут в досье: 300 карточек авто = только счёт за токены
DOSSIER_NORMALIZE_RU=true                       # (§20) свести двуязычный сайт (напр. darial.co.jp EN+RU) к языку владельца и схлопнуть кросс-язычные дубли услуг/УТП/фактов; false = прежнее (рынки всё равно канонизирует КОД)
PROFILE_CTX_CHARS=3000                          # сколько символов досье/профиля уезжает КОНТЕКСТОМ в генераторы (RSA, ключи, кластеры)
EXECUTING_STALE_MINUTES=30                      # (§12) executing-черновик старше N мин => needs_review
CLIENT_TEXT_IDLE_S=60                           # (§20.3) окно накопления текста профиля
