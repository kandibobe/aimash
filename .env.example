# ───────────────────────────────────────────────────────────────
# Aimash — пример окружения. Скопируй в .env и заполни.
# .env в .gitignore — НИКОГДА не коммить реальные значения.
# ───────────────────────────────────────────────────────────────

# --- Модель (через OpenRouter, OpenAI-совместимый API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Сменяемые модели (выбор по A/B-тесту scripts/ab_test_models.py):
# Hermes на OpenRouter НЕ поддерживает function calling → не годится на денежный путь.
# «Что за что»: parsing — разбор команд (дёшево, ошибку ловит confirm-гейт); copy — тексты RSA
# (качество РУССКОГО важнее цены). Ручной выбор оператора через /model в боте бьёт эти дефолты.
LLM_PARSING=deepseek/deepseek-chat          # дёшево, ≈Claude на парсинге команд
LLM_COPY=anthropic/claude-sonnet-4.6        # топ-копирайт RU для RSA (можно opus-4.8 для максимума)
LLM_FALLBACK=anthropic/claude-sonnet-4.6    # топ-надёжность как запасная
# Ускорение parsing-роли: роутинг к быстрейшему эндпоинту модели (provider:{sort}). Пусто = ВЫКЛ
# (дефолт). throughput = выше токенов/с, latency = ниже TTFT. Только parsing; копирайт не трогает.
# Замерь выигрыш через scripts/ab_test_models.py (колонка TTFT) перед включением в prod.
OPENROUTER_PARSING_PROVIDER_SORT=           # пусто | throughput | latency
# Пресеты моделей для рантайм-переключателя /model (CSV slug'ов OpenRouter). Пусто = дефолтный
# набор в agent.router (tool-use-capable). Своя модель — командой /model в боте.
MODEL_CHOICES=                              # напр. deepseek/deepseek-chat,openai/gpt-4o-mini,anthropic/claude-sonnet-4.6
# Потолок генерации по ролям (явный max_tokens — экономия бюджета OpenRouter без потери качества).
LLM_MAX_TOKENS_PARSING=1024                  # разбор команд → крошечный tool-call
LLM_MAX_TOKENS_COPY=2048                     # копирайт RSA → короткий JSON
# :floor — роутинг к самому дешёвому провайдеру модели (фиксирует на одном эндпоинте → операционно
# рискованнее). По умолчанию false (надёжность важнее экономии копеек).
OPENROUTER_PRICE_FLOOR=false                 # false | true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                            # @BotFather
# ОБЯЗАТЕЛЬНО (даже в dev): whitelist FAIL-CLOSED — пустой => бот НИКОМУ не ответит.
# В prod пустой whitelist роняет старт (fail-fast). Укажи хотя бы свой chat_id.
TELEGRAM_WHITELIST_CHAT_IDS=                   # через запятую, напр. 12345678,87654321

# --- Google Ads API ---
# Альтернатива google-ads.yaml. developer token — Basic (у Антона).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=                  # ID МЕНЕДЖЕРСКОГО (MCC), напр. 6283738601
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=               # белый список аккаунтов через запятую (ЗАЩИТА боевых клиентов!)
GOOGLE_ADS_API_VERSION=v24                     # пин; перепроверять ежемесячно

# --- Безопасность ---
ENV=dev                                        # dev | prod  (dev = только test MCC)
SECRETS_ENCRYPTION_KEY=                         # Fernet-ключ для шифрования токенов в БД (32 b64)

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://aimash:aimash@localhost:5432/aimash

# --- Google Sheets экспорт (фаза 2) ---
# Scope (drive.file) ЗАШИТ в коде (reports/sheets.py) — отдельной env-настройки нет. Нужен
# ОТДЕЛЬНЫЙ OAuth с этим scope (Ads-токен его не несёт) — см. docs/DEPLOYMENT.md.

# --- Наблюдаемость / мониторинг (опционально) ---
# Sentry: алерты о падениях на денежном пути. Пусто = ВЫКЛ (ноль оверхеда и сети, секреты редактятся).
SENTRY_DSN=                                    # https://...@oNNN.ingest.sentry.io/NNN (с dashboard Sentry)
SENTRY_TRACES_SAMPLE_RATE=0.0                  # перф-трейсинг: 0.0 = выкл (без оверхеда); 0.1 = 10% и т.п.
