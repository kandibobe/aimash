# Secrets — НИКОГДА не коммитить
.env
.env.*
!.env.example
# .env.defaults — несекретные операционные дефолты, деплоятся в прод через env_file (секретов нет):
!.env.defaults
google-ads.yaml
google-ads-oauth*.json
*.pem
*.key
client_secret*.json
service_account*.json
token.json
credentials.json
secrets/

# Claude Code — локальные настройки/секреты сессии (env для ${VAR} в .mcp.json)
.claude/settings.local.json
!.claude/settings.local.example.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Tooling / caches
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# DB / local data
*.sqlite3
*.sqlite
*.db
data/
dumps/
# C1: авто-дампы pg_dump (docker-compose backup-сайдкар ./backups:/backups) — pg_dump -Fc ВСЕЙ БД,
# включая audit_log и шифрованные oauth_tokens. Живут на VPS, в гит не попадают НИКОГДА.
# ⚠️ Комментарий обязан быть на ОТДЕЛЬНОЙ строке: git не знает trailing-комментариев и читает
# `backups/    # ...` как один литерал — паттерн молча не срабатывает (гард в tests/test_ignore_sync.py).
backups/
*.dump

# A/B test outputs (могут содержать данные)
ab_results/
*.ab.json

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Мусор редакторов, патчей и merge-конфликтов
*.bak
*.orig
*.rej
*.tmp

# client documents — keep local only, never commit
*.docx
ТЗ.md
