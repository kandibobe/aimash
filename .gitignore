# Secrets — НИКОГДА не коммитить
.env
.env.*
!.env.example
# .env.defaults — несекретные операционные дефолты, деплоятся в прод через env_file (секретов нет):
!.env.defaults
google-ads.yaml
google-ads-oauth*.json
*.pem
*.key
client_secret*.json
service_account*.json
token.json
credentials.json
secrets/

# Claude Code — локальные настройки/секреты сессии (env для ${VAR} в .mcp.json)
.claude/settings.local.json
!.claude/settings.local.example.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

