# ─────────────────────────────────────────────────────────────────────────────
# Hermes Agent — ШАБЛОН секретов Контура A. Копируется на VPS в ~/.hermes/.env
# (путь показывает `hermes config env-path`), значения заполняются реальными.
#
# ⛔ ЭТО ШАБЛОН. Реальный ~/.hermes/.env НЕ коммитить (секреты, правило 5).
# ⚠️ Google Ads секретов здесь НЕТ. OAuth Google Ads живёт ТОЛЬКО в окружении контейнера
#    aimash-bot (/opt/aimash/.env), куда ходит MCP-сервер. Hermes знает лишь эти ключи.
# ─────────────────────────────────────────────────────────────────────────────

# LLM: у вас уже есть рабочий ключ OpenRouter. Рекомендация RB-3 — provisioning-ключ с
# дневным потолком (limit + limit_reset: daily): confirm-гейт защищает бюджет Google Ads,
# а не трату LLM (Hermes зовёт OpenRouter напрямую, мимо нашего кода).
OPENROUTER_API_KEY=

# Telegram: ОТДЕЛЬНЫЙ бот для Hermes (не токен текущего aiogram-бота — иначе 409, один
# токен = один поллер). Токен — от @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Ваш user id (@userinfobot). Кому можно в личке/общий доступ. Через запятую для нескольких.
TELEGRAM_ALLOWED_USERS=

# id супергруппы — ОТРИЦАТЕЛЬНЫЙ (-100…). Жёсткий гейт: сообщения из групп вне списка
# молча отбрасываются, даже с упоминанием. Через запятую для нескольких.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Не диспатчить агента на неупомянутые сообщения из разрешённых чатов (тихий режим).
TELEGRAM_GUEST_MODE=false
