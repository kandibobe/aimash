# ─────────────────────────────────────────────────────────────────────────────
# Hermes Agent — ШАБЛОН секретов Контура A. Копируется на VPS в ~/.hermes/.env
# (путь показывает `hermes config env-path`), значения заполняются реальными.
#
# ⛔ ЭТО ШАБЛОН. Реальный ~/.hermes/.env НЕ коммитить (секреты, правило 5).
# ⚠️ Google Ads секретов здесь НЕТ. OAuth Google Ads живёт ТОЛЬКО в окружении контейнера
#    aimash-bot (/opt/aimash/.env), куда ходит MCP-сервер. Hermes знает лишь эти ключи.
# ─────────────────────────────────────────────────────────────────────────────

# LLM: у вас уже есть рабочий ключ OpenRouter. Рекомендация RB-3 — provisioning-ключ с
# дневным потолком (limit + limit_reset: daily): confirm-гейт защищает бюджет Google Ads,
# а не трату LLM (Hermes зовёт OpenRouter напрямую, мимо нашего кода).
OPENROUTER_API_KEY=

# Telegram: ОТДЕЛЬНЫЙ бот для Hermes (не токен текущего aiogram-бота — иначе 409, один
# токен = один поллер). Токен — от @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Ваш user id (@userinfobot). Кому можно в личке/общий доступ. Через запятую для нескольких.
TELEGRAM_ALLOWED_USERS=

# id супергруппы — ОТРИЦАТЕЛЬНЫЙ (-100…). Жёсткий гейт: сообщения из групп вне списка
# молча отбрасываются, даже с упоминанием. Через запятую для нескольких.
# ⚠️ Установленная версия этой переменной НЕ знает — её нет в списке `hermes config check`
#    [Проверено на VPS 21.07]. Реальный гейт группы задаётся в config.yaml:
#    gateway.platforms.telegram.extra.group_allowed_chats. Строку держим для симметрии, но
#    полагаться на неё нельзя — проверять живьём: упоминание из ПОСТОРОННЕЙ группы → тишина.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Не диспатчить агента на неупомянутые сообщения из разрешённых чатов (тихий режим).
TELEGRAM_GUEST_MODE=false

# Тулсет `web` без ключа поискового провайдера МЁРТВ (web_search/web_extract не появятся).
# Нужен ровно один из: TAVILY_API_KEY / BRAVE_SEARCH_API_KEY / EXA_API_KEY / FIRECRAWL_API_KEY
# / SEARXNG_URL. Пока ключа нет — держать `web` в agent.disabled_toolsets.
# TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ВРЕМЕННЫЕ переменные прогона замеров V1–V22 (OPERATIONS.md §12). Секретами НЕ являются.
# ⛔ Снимаются на шаге V18 вместе с плагином — не оставлять на живом gateway.
#    Раньше о них можно было узнать только из §12 и из кода прибора; выписаны сюда, чтобы
#    «снять всё» было проверяемо по одному файлу.
# ⛔ Переменных НЕДОСТАТОЧНО: плагин не подпишется ни на что, пока его имя не внесено в
#    `plugins.enabled` в ~/.hermes/config.yaml — это задаётся конфигом, не окружением.
# ─────────────────────────────────────────────────────────────────────────────

# Куда пишет лог-прибор. Дефолт ~/.hermes/aimash_probe.log. Файл вывозится/удаляется в V19:
# редакция хука ловит секреты ПО ФОРМЕ, за чужие поля payload'а она не отвечает.
# AIMASH_PROBE_LOG=

# V9a: разрешить хуку ПЕРЕЗАПИСАТЬ аргументы, которые заполнила модель (actor_chat_id,
# reply_to_message_id → HOOK_SUBSTITUTED). Только "1" включает. Выключено — прибор
# исключительно наблюдает. Поведение НЕ документировано (единственный документированный
# возврат pre_tool_call — block), отрицательный исход ожидаем и провалом не является.
# AIMASH_PROBE_REWRITE=0

# V9b: имя инструмента, который хук обязан ОТБИТЬ документированным {"action": "block"}.
# На этом механизме стоит К9-гард: не работает вето — запретить инструмент в рантайме нечем,
# и остаётся единственный способ по правилу 8: не регистрировать его вовсе.
# AIMASH_PROBE_BLOCK=probe_echo

# V10: заставить хук УПАСТЬ, чтобы измерить fail-open/fail-closed. gateway | tool.
# fail-OPEN на денежном пути = подтверждение, сфабрикованное моделью.
# AIMASH_PROBE_RAISE=
